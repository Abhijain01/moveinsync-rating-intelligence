# Copy to .env (never commit .env). Everything here is optional: the pipeline works with none of it.
# The only optional AI layer is a LOCAL, free Ollama server. No paid API is supported.
RI_LLM_PROVIDER=none
# RI_LLM_PROVIDER=ollama
# RI_OLLAMA_URL=http://localhost:11434
# RI_OLLAMA_MODEL=llama3.1:8b
# RI_LLM_TIMEOUT=60
